rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
