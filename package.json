{
	"name": "thebuilder-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"dev": "turbo run dev",
		"dev:home": "turbo run dev --filter=@thebuilder/home",
		"dev:admin": "turbo run dev --filter=@thebuilder/admin",
		"build": "turbo run build --concurrency=1",
		"typecheck": "turbo run typecheck",
		"lint": "turbo run lint:root",
		"lint:root": "biome check .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "turbo run test:ci",
		"test:ci": "vitest run --maxWorkers=2",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "^4.0.18",
		"autoprefixer": "^10.4.23",
		"jsdom": "^27.4.0",
		"postcss": "^8.5.6",
		"puppeteer": "^25.12.0",
		"tailwindcss": "^3.4.14",
		"turbo": "2.11.2",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"vitest": "^4.0.18"
	}
}
